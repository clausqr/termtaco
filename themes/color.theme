# A colorful termtaco theme. Copy to ~/.config/termtaco/theme to use it:
#   cp themes/color.theme ~/.config/termtaco/theme
#
# Any line this file omits keeps its plain white/gray default, so you can
# also start from a blank file and override just a couple of fields.
arc = cyan
tick_minor = dark_gray
tick_major = cyan
tick_label = white
needle = yellow
raw = light_blue
min_max = blue
mean = green
band = magenta
hub = white
value = green
stats = gray
marker = blue
title = cyan
alarm = light_red
led_off = dark_gray
stale = yellow
